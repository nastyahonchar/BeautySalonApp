<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BeautySalon.MAUI.Views.LoginPage"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F8FF" Offset="0.0"/>
            <GradientStop Color="#D8EAF8" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="35,60,35,40" Spacing="0">

            <Frame
                WidthRequest="120" HeightRequest="120" CornerRadius="60"
                BackgroundColor="White" BorderColor="#E0E0E0"
                Padding="0" HorizontalOptions="Center"
                HasShadow="True" Margin="0,0,0,24"
                IsClippedToBounds="True">
                <Image
                    Source="logo.svg"
                    Aspect="AspectFit"
                    WidthRequest="120"
                    HeightRequest="120"/>
            </Frame>

            <Label
                Text="Welcome to GlowBeauty!"
                FontSize="20" FontAttributes="Bold"
                TextColor="#462EB7"
                HorizontalOptions="Center"
                Margin="0,0,0,32"/>

            <Label Text="Email" FontSize="14" TextColor="#462EB7" Margin="0,0,0,6"/>

            <Frame Padding="14,0" CornerRadius="10" BackgroundColor="White"
                   BorderColor="#CCCCCC" HeightRequest="52" Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0"
                           Source="icon_email.svg"
                           WidthRequest="20" HeightRequest="20"
                           VerticalOptions="Center"/>
                    <Entry Grid.Column="1" x:Name="EmailEntry"
                           Placeholder="name@example.com" Keyboard="Email"
                           PlaceholderColor="#AAAAAA" TextColor="Black"
                           BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Label Text="Password" FontSize="14" TextColor="#462EB7" Margin="0,0,0,6"/>

            <Frame Padding="14,0" CornerRadius="10" BackgroundColor="White"
                   BorderColor="#CCCCCC" HeightRequest="52" Margin="0,0,0,28">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0"
                           Source="icon_lock.svg"
                           WidthRequest="20" HeightRequest="20"
                           VerticalOptions="Center"/>
                    <Entry Grid.Column="1" x:Name="PasswordEntry"
                           Placeholder="••••••••" IsPassword="True"
                           PlaceholderColor="#AAAAAA" TextColor="Black"
                           BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Grid HeightRequest="54" Margin="0,0,0,36">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLoginClicked"/>
                </Grid.GestureRecognizers>
                <BoxView CornerRadius="12" Opacity="0.9">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#715FE7" Offset="0.0"/>
                            <GradientStop Color="#573DD2" Offset="0.5"/>
                            <GradientStop Color="#492FB9" Offset="1.0"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Label Text="LOG IN  →" FontSize="15" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <Label Text="Don't have an account?" FontSize="14" TextColor="#462EB7"
                   HorizontalOptions="Center" Margin="0,0,0,12"/>

            <Grid HeightRequest="54">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSignUpClicked"/>
                </Grid.GestureRecognizers>
                <BoxView CornerRadius="12" Opacity="0.9">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#715FE7" Offset="0.0"/>
                            <GradientStop Color="#573DD2" Offset="0.5"/>
                            <GradientStop Color="#492FB9" Offset="1.0"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Label Text="Sign up" FontSize="15" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>