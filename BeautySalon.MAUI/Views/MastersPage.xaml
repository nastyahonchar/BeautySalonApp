<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BeautySalon.MAUI.Views"
    x:Class="BeautySalon.MAUI.Views.MastersPage"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F8FF" Offset="0.0"/>
            <GradientStop Color="#D8EAF8" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*,80">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="15,50,20,15">
            <Image Grid.Column="0"
                   Source="icon_back.svg"
                   WidthRequest="24" HeightRequest="24"
                   VerticalOptions="Center" Margin="5,0,0,0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1"
                   Text="Master's choice"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="#462EB7"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="#573DD2"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Masters}"
            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            Margin="20,5">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" CornerRadius="14"
                           BackgroundColor="#DCE9FA" BorderColor="Transparent">
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <Frame Grid.Column="0" Padding="0" CornerRadius="10"
                                   BorderColor="Transparent" BackgroundColor="#D0D0D0"
                                   WidthRequest="100" HeightRequest="100"
                                   IsClippedToBounds="True">
                                <Image Source="{Binding PhotoUrl}" Aspect="AspectFill"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding FullName}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                <Label Text="{Binding Position}"
                                       FontSize="13" TextColor="#555"/>
                                <Label Text="{Binding Rating, StringFormat='Rating: ⭐ {0:F1}'}"
                                       FontSize="13" TextColor="#555"/>
                                <Grid HeightRequest="36" Margin="0,4,0,0">
                                    <BoxView CornerRadius="18">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#715FE7" Offset="0.0"/>
                                                <GradientStop Color="#573DD2" Offset="0.5"/>
                                                <GradientStop Color="#492FB9" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    <Label Text="SELECT" FontSize="13" FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="OnMasterSelected"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <views:BottomTabBar Grid.Row="2" ActiveTab="Home"/>

    </Grid>
</ContentPage>