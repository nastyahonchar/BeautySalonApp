<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BeautySalon.MAUI.Views.RegisterPage"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F8FF" Offset="0.0"/>
            <GradientStop Color="#D8EAF8" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="35,50,35,40" Spacing="0">

            <Image Source="icon_back.svg"
                   WidthRequest="24" HeightRequest="24"
                   HorizontalOptions="Start"
                   Margin="0,0,0,20">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Image.GestureRecognizers>
            </Image>

            <Label Text="Create account"
                   FontSize="24" FontAttributes="Bold"
                   TextColor="#462EB7"
                   Margin="0,0,0,8"/>
            <Label Text="Fill in your details to get started"
                   FontSize="14" TextColor="#888"
                   Margin="0,0,0,32"/>

            <Label Text="First Name" FontSize="14" TextColor="#462EB7" Margin="0,0,0,6"/>
            <Frame Padding="14,0" CornerRadius="10" BackgroundColor="White"
                   BorderColor="#CCCCCC" HeightRequest="52" Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="icon_user.svg"
                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" x:Name="FirstNameEntry"
                           Placeholder="Anna" PlaceholderColor="#AAAAAA"
                           TextColor="Black" BackgroundColor="Transparent"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Label Text="Last Name" FontSize="14" TextColor="#462EB7" Margin="0,0,0,6"/>
            <Frame Padding="14,0" CornerRadius="10" BackgroundColor="White"
                   BorderColor="#CCCCCC" HeightRequest="52" Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="icon_user.svg"
                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" x:Name="LastNameEntry"
                           Placeholder="Peterson" PlaceholderColor="#AAAAAA"
                           TextColor="Black" BackgroundColor="Transparent"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Label Text="Phone" FontSize="14" TextColor="#462EB7" Margin="0,0,0,6"/>
            <Frame Padding="14,0" CornerRadius="10" BackgroundColor="White"
                   BorderColor="#CCCCCC" HeightRequest="52" Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="icon_phone.png"
                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" x:Name="PhoneEntry"
                           Placeholder="+380 00 000 00 00"
                           Keyboard="Telephone"
                           PlaceholderColor="#AAAAAA" TextColor="Black"
                           BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Label Text="Email" FontSize="14" TextColor="#462EB7" Margin="0,0,0,6"/>
            <Frame Padding="14,0" CornerRadius="10" BackgroundColor="White"
                   BorderColor="#CCCCCC" HeightRequest="52" Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="icon_email.svg"
                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" x:Name="EmailEntry"
                           Placeholder="name@example.com" Keyboard="Email"
                           PlaceholderColor="#AAAAAA" TextColor="Black"
                           BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Label Text="Password" FontSize="14" TextColor="#462EB7" Margin="0,0,0,6"/>
            <Frame Padding="14,0" CornerRadius="10" BackgroundColor="White"
                   BorderColor="#CCCCCC" HeightRequest="52" Margin="0,0,0,32">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="icon_lock.svg"
                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" x:Name="PasswordEntry"
                           Placeholder="••••••••" IsPassword="True"
                           PlaceholderColor="#AAAAAA" TextColor="Black"
                           BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Grid HeightRequest="54">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterClicked"/>
                </Grid.GestureRecognizers>
                <BoxView CornerRadius="12" Opacity="0.9">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#715FE7" Offset="0.0"/>
                            <GradientStop Color="#573DD2" Offset="0.5"/>
                            <GradientStop Color="#492FB9" Offset="1.0"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Label Text="SIGN UP  →" FontSize="15" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>